# --- Credenciales y configuración local -------------------------------------
# NUNCA subir: contiene SECRET_KEY y el token de Mercado Pago
.env
.env.*
!.env.example

# --- Base de datos ----------------------------------------------------------
# La base local guarda ventas reales y los PIN de los usuarios (hasheados).
# Un PIN de 4 dígitos se rompe en segundos si el hash es público.
*.db
*.db-journal
*.sqlite
*.sqlite3
!**/ejemplo.db

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
env/

# --- Node -------------------------------------------------------------------
node_modules/
node_modules_*/
frontend/dist/
frontend/dev-dist/

# --- Editores y sistema operativo -------------------------------------------
# Se ignora el contenido y no la carpeta: excluido el directorio, git no entra
# y cualquier excepción de adentro queda sin efecto.
.vscode/*
# Las tareas sí se comparten: sirven en cualquier máquina y no tienen datos propios
!.vscode/tasks.json
.idea/
Thumbs.db
.DS_Store
desktop.ini

# --- Temporales -------------------------------------------------------------
*.bak
*.tmp
scratch_*.py

# Cache de pytest
.pytest_cache/

# Certificado de desarrollo para HTTPS (se genera con scripts/generar-certificado.sh)
frontend/certs/
*.key
*.crt
*.pem

# Herramientas descargadas (pnpm)
.tools/

# Copias de la base: traen las ventas y los PIN hasheados
backend/respaldos/
