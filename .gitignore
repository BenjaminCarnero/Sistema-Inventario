# --- Credenciales y configuración local -------------------------------------
# NUNCA subir: contiene SECRET_KEY y el token de Mercado Pago
.env
.env.*
!.env.example

# --- Base de datos ----------------------------------------------------------
# La base local guarda ventas reales y los PIN de los usuarios (hasheados).
# Un PIN de 4 dígitos se rompe en segundos si el hash es público.
*.db
*.db-journal
# WAL deja estos dos archivos al lado de la base mientras está en uso
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Copias hechas a mano antes de migrar: "applify.db.antes-de-xxxx" y parecidas.
# Sin esto no las tapa el "*.db" de arriba y terminan en un commit.
*.db.*
!**/ejemplo.db

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
env/

# --- Node -------------------------------------------------------------------
node_modules/
node_modules_*/
frontend/dist/
frontend/dev-dist/

# --- Editores y sistema operativo -------------------------------------------
# Se ignora el contenido y no la carpeta: excluido el directorio, git no entra
# y cualquier excepción de adentro queda sin efecto.
.vscode/*
# Las tareas sí se comparten: sirven en cualquier máquina y no tienen datos propios
!.vscode/tasks.json
.idea/
Thumbs.db
.DS_Store
desktop.ini

# --- Temporales -------------------------------------------------------------
*.bak
*.tmp
scratch_*.py

# Cache de pytest
.pytest_cache/

# Certificado de desarrollo para HTTPS (se genera con scripts/generar-certificado.sh)
frontend/certs/
*.key
*.crt
*.pem

# Herramientas descargadas (pnpm)
.tools/

# Copias de la base: traen las ventas y los PIN hasheados
backend/respaldos/

# Registro de errores del backend: es de esta máquina y puede tener datos del local
backend/logs/

# --- Instalador de Windows ---------------------------------------------------
# Binarios de terceros que arma quien empaqueta (ver installer/README.md):
# no son código de este proyecto y son pesados para el repositorio.
installer/vendor/
installer/dist/
