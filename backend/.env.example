# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube al repositorio: contiene credenciales.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# Clave con la que se firman los tokens de sesión. OBLIGATORIA en producción.
# Generá una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambiás, todas las sesiones abiertas se cierran.
SECRET_KEY=

# Base de datos. Por defecto SQLite, que no necesita instalar nada.
# Para SQL Server:
#   mssql+pyodbc://usuario:clave@host:1433/base?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=sqlite:///./applify.db

# Token de Mercado Pago. Sin esto, el cobro por QR devuelve 503 y el POS
# oculta ese método. El de pruebas empieza con TEST-, el real con APP_USR-.
MERCADOPAGO_ACCESS_TOKEN=

# A dónde vuelve el cliente después de pagar con el QR. Tiene que ser la
# dirección pública del POS: apuntando a localhost, el que paga desde su
# celular termina en una página que sólo existe en la máquina de la caja.
# Con ENTORNO=produccion, dejarlo en localhost es un error de arranque.
FRONTEND_URL=http://localhost:5173

# Carpeta donde dejar una SEGUNDA copia de cada respaldo, fuera de este disco.
# Las copias locales no protegen del caso más probable: que este disco se rompa
# o que se pierda la computadora. Apuntá a una carpeta que ya se sincronice
# sola (Drive, OneDrive) o a un pendrive que quede siempre puesto.
# Vacío = sólo copias locales. Si la carpeta no está disponible, el respaldo
# local se hace igual y queda el aviso en backend/logs/.
#   RESPALDO_EXTERNO=C:\Users\vos\OneDrive\respaldos-pos
RESPALDO_EXTERNO=

# Desde qué direcciones puede llamar el navegador a la API.
# En producción poné tu dominio real. Nunca uses "*" con sesiones abiertas.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Carpeta del frontend ya compilado (`pnpm build` lo deja en frontend/dist).
# Si existe, la sirve la misma aplicación: un solo puerto y un solo proceso.
# Vacío = se busca en ../frontend/dist.
FRONTEND_DIST=

# Cuántos proxies propios hay delante (nginx, Caddy, el balanceador del
# hosting). Con 0 la IP del cliente sale del socket, que es lo correcto cuando
# la aplicación se expone directo.
#
# IMPORTANTE si vas a poner un reverse proxy: sin esto TODAS las peticiones
# llegan con la IP del proxy, así que el freno contra el barrido de cuentas
# bloquearía a todo el local de una sola vez y el freno por cuenta dejaría de
# distinguir a nadie. Con un nginx adelante, poné 1.
PROXIES_CONFIABLES=0

# Techo de peticiones por IP y por minuto, fuera del login (que tiene su propio
# freno, más estricto). 0 lo desactiva. Subilo si un local con muchas cajas
# empieza a ver 429.
LIMITE_PETICIONES_POR_MINUTO=300

# Zona horaria del comercio (formato IANA). Define dónde empieza y termina "el
# día" para los arqueos y los reportes. Vacío = la del reloj del servidor.
#
# Ponela siempre que el servidor no esté en el local: un VPS en UTC corta el
# día a las 21:00 hora argentina, así que las ventas de la noche aparecen en el
# reporte del día siguiente y el arqueo del turno no cierra.
#   ZONA_HORARIA=America/Argentina/Buenos_Aires
ZONA_HORARIA=

# "produccion" endurece el arranque: exige SECRET_KEY, prohíbe CORS "*",
# oculta la documentación de la API y activa HSTS.
ENTORNO=desarrollo
